<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Ambient Drop Shadow -->
    <path
        android:fillColor="#55000000"
        android:pathData="M37,28 L51,28 L51,69 L73,69 L73,84 L37,84 Z" />

    <!-- 2. Back Vertical Ribbon (Darker Crimson) -->
    <path
        android:pathData="M36,26 L50,26 L50,82 L36,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="26"
                android:endX="43"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#B81D24" />
                <item android:offset="0.6" android:color="#9E0F16" />
                <item android:offset="1.0" android:color="#6D060B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Ribbon Fold Depth Shadow -->
    <path
        android:pathData="M36,68 L50,82 L36,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="70"
                android:endX="48"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#99000000" />
                <item android:offset="1.0" android:color="#1A000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Front Horizontal Ribbon (Vibrant Scarlet Netflix Red with Fold) -->
    <path
        android:pathData="M36,68 L50,82 L72,82 L72,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="68"
                android:endX="72"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1E27" />
                <item android:offset="0.4" android:color="#E50914" />
                <item android:offset="1.0" android:color="#BD111B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Crisp Fold Highlight Sheen Line -->
    <path
        android:pathData="M36,68 L50,82"
        android:strokeWidth="0.8"
        android:strokeColor="#55FFFFFF" />
</vector>